---
source: crates/app-core/tests/it/registry.rs
expression: command_schema()
---
{
  "$defs": {
    "AccountId": {
      "description": "A configured mail account.",
      "format": "uuid",
      "type": "string"
    },
    "Addr": {
      "description": "A mail address with an optional display name.",
      "properties": {
        "email": {
          "description": "Address, e.g. `alice@example.com`.",
          "type": "string"
        },
        "name": {
          "description": "Display name, e.g. `Alice Example`. Untrusted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "email"
      ],
      "type": "object"
    },
    "ApprovalId": {
      "description": "An agent-initiated request that waits for user approval.",
      "format": "uuid",
      "type": "string"
    },
    "AttachmentRef": {
      "description": "A local file attached to a draft. The core only records the path; the runtime checks the file\n(`InspectAttachment`) and reads it when the draft is rendered.",
      "properties": {
        "name": {
          "description": "File name shown to recipients (the last path component).",
          "type": "string"
        },
        "path": {
          "description": "Absolute path of the file.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AttachmentState",
          "description": "Whether the file was found and fits the size limit."
        }
      },
      "required": [
        "path",
        "name",
        "state"
      ],
      "type": "object"
    },
    "AttachmentState": {
      "description": "The check of an attached file.",
      "oneOf": [
        {
          "description": "The runtime is checking the file.",
          "properties": {
            "state": {
              "const": "checking",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "The file exists and fits the limit.",
          "properties": {
            "content_type": {
              "description": "MIME type, guessed from the file name.",
              "type": "string"
            },
            "size": {
              "description": "Size in bytes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "const": "ready",
              "type": "string"
            }
          },
          "required": [
            "state",
            "size",
            "content_type"
          ],
          "type": "object"
        },
        {
          "description": "The file is missing, unreadable or too large; the draft can't be sent with it.",
          "properties": {
            "error": {
              "description": "Why.",
              "type": "string"
            },
            "state": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "Draft": {
      "description": "A message being written.",
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountId",
          "description": "The account that sends it."
        },
        "attachments": {
          "description": "Files to attach, in order. The runtime reads them when it renders the draft.",
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          },
          "type": "array"
        },
        "bcc": {
          "default": [],
          "description": "`Bcc` recipients (never shown to the other recipients).",
          "items": {
            "$ref": "#/$defs/Addr"
          },
          "type": "array"
        },
        "body_text": {
          "default": "",
          "description": "Plain-text body written by the user or agent (without the quoted original).",
          "type": "string"
        },
        "cc": {
          "default": [],
          "description": "`Cc` recipients.",
          "items": {
            "$ref": "#/$defs/Addr"
          },
          "type": "array"
        },
        "created_ms": {
          "description": "When the draft was created, in Unix milliseconds.",
          "format": "int64",
          "type": "integer"
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Addr"
            },
            {
              "type": "null"
            }
          ],
          "description": "The address it is sent from (`set_draft_from`); the account's own if unset."
        },
        "id": {
          "$ref": "#/$defs/DraftId",
          "description": "Draft ID."
        },
        "in_reply_to": {
          "description": "`In-Reply-To` header (a reply's parent), without angle brackets.",
          "type": [
            "string",
            "null"
          ]
        },
        "message_id_hdr": {
          "description": "`Message-ID` the draft is saved and sent with, without angle brackets. Stays the same\nfor the draft's whole life.",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quote"
            },
            {
              "type": "null"
            }
          ],
          "description": "The original message quoted below the body (replies) or forwarded (forwards)."
        },
        "references": {
          "description": "`References` header IDs, oldest first, without angle brackets.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reply_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/MessageId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The message this draft answers or forwards, if any."
        },
        "save_error": {
          "description": "Why the last save to the server failed, if it did.",
          "type": [
            "string",
            "null"
          ]
        },
        "saved_ms": {
          "description": "`updated_ms` of the version stored in the account's Drafts mailbox (`None`: not saved\non the server yet). The draft is saved again when it differs from `updated_ms`.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "send_at": {
          "description": "When a scheduled send leaves (Unix milliseconds). Until then `cancel_send` (or undo)\nstops it; the draft can't be edited meanwhile.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "send_error": {
          "description": "Why the last send failed, if it did (the draft is back to editable).",
          "type": [
            "string",
            "null"
          ]
        },
        "sending": {
          "description": "The message has been handed to the runtime for SMTP; it can't be stopped any more.",
          "type": "boolean"
        },
        "subject": {
          "default": "",
          "description": "Subject.",
          "type": "string"
        },
        "to": {
          "default": [],
          "description": "`To` recipients.",
          "items": {
            "$ref": "#/$defs/Addr"
          },
          "type": "array"
        },
        "updated_ms": {
          "description": "When the draft was last changed, in Unix milliseconds.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "account",
        "message_id_hdr",
        "created_ms",
        "updated_ms"
      ],
      "type": "object"
    },
    "DraftId": {
      "description": "A local draft.",
      "format": "uuid",
      "type": "string"
    },
    "Endpoint": {
      "description": "A mail server address. Plaintext connections are not supported.",
      "properties": {
        "host": {
          "description": "Host name, e.g. `imap.gmail.com`.",
          "type": "string"
        },
        "port": {
          "description": "TCP port, e.g. 993 (IMAP over TLS) or 465 (SMTP over TLS).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "security": {
          "$ref": "#/$defs/Security",
          "description": "How the connection is secured."
        }
      },
      "required": [
        "host",
        "port",
        "security"
      ],
      "type": "object"
    },
    "FolderKey": {
      "description": "A node of an account's folder tree: a mailbox, or a parent folder that is not cached\n(`\\Noselect`). An empty `path` stands for the whole account.",
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountId",
          "description": "The account."
        },
        "path": {
          "default": "",
          "description": "The folder's full path; empty for the account itself.",
          "type": "string"
        }
      },
      "required": [
        "account"
      ],
      "type": "object"
    },
    "KeyPreset": {
      "description": "A set of key bindings.",
      "oneOf": [
        {
          "const": "gmail",
          "description": "Gmail's keys: `j`/`k`, `e` archive, `#` trash, `u` read/unread, `z` undo, …",
          "type": "string"
        },
        {
          "const": "vim",
          "description": "Vim-minded: as Gmail, but `u` undoes, `Ctrl+R` redoes, `d d` trashes, `m r` / `m u`\nmark read / unread and `F5` or `g r` syncs.",
          "type": "string"
        }
      ]
    },
    "MailboxId": {
      "description": "A mailbox (IMAP folder) of one account.",
      "format": "uuid",
      "type": "string"
    },
    "MessageId": {
      "description": "One message copy, i.e. one `(mailbox, uid)` pair.",
      "format": "uuid",
      "type": "string"
    },
    "OpId": {
      "description": "A pending remote operation in the outbox.",
      "format": "uuid",
      "type": "string"
    },
    "Pane": {
      "description": "A pane of the main window.",
      "oneOf": [
        {
          "const": "sidebar",
          "description": "Accounts and mailboxes.",
          "type": "string"
        },
        {
          "const": "list",
          "description": "The thread list (a mailbox or search results).",
          "type": "string"
        },
        {
          "const": "reader",
          "description": "The open thread.",
          "type": "string"
        },
        {
          "const": "composer",
          "description": "The open draft.",
          "type": "string"
        }
      ]
    },
    "ProviderPreset": {
      "description": "Provider preset. Provider differences are data ([`PresetProfile`]), not code branches.",
      "oneOf": [
        {
          "const": "hostinger",
          "description": "Hostinger Mail (imap/smtp.hostinger.com).",
          "type": "string"
        },
        {
          "const": "gmail",
          "description": "Gmail with an App Password (requires 2-step verification).",
          "type": "string"
        },
        {
          "const": "custom",
          "description": "Any other IMAP/SMTP provider; servers must be given explicitly.",
          "type": "string"
        }
      ]
    },
    "Quote": {
      "description": "The original message of a reply or forward. The runtime renders `header`, then the\noriginal's body text (quoted with `> ` for replies) below the draft's own text.",
      "properties": {
        "header": {
          "description": "The line(s) above the quoted text, e.g. `On 2023-11-14 22:13 UTC, Bob <bob@x> wrote:`.\nBuilt from the original's headers, so it is email content.",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/MessageId",
          "description": "The quoted message."
        },
        "style": {
          "$ref": "#/$defs/QuoteStyle",
          "description": "Reply (quoted with `> `) or forward (inline, with a header block)."
        }
      },
      "required": [
        "message",
        "style",
        "header"
      ],
      "type": "object"
    },
    "QuoteStyle": {
      "description": "How a [`Quote`] is rendered.",
      "oneOf": [
        {
          "const": "reply",
          "description": "Every line prefixed with `> `.",
          "type": "string"
        },
        {
          "const": "forward",
          "description": "Inline, below a \"Forwarded message\" header block.",
          "type": "string"
        }
      ]
    },
    "SearchOrder": {
      "description": "How `search` orders its threads.",
      "oneOf": [
        {
          "const": "newest",
          "description": "Newest first.",
          "type": "string"
        },
        {
          "const": "relevance",
          "description": "Full-text hits first, best match first; then the rest, newest first.",
          "type": "string"
        }
      ]
    },
    "Security": {
      "description": "Transport security of an [`Endpoint`].",
      "oneOf": [
        {
          "const": "tls",
          "description": "TLS from the first byte (IMAP 993, SMTP 465).",
          "type": "string"
        },
        {
          "const": "starttls",
          "description": "Plain connection upgraded with STARTTLS before login (IMAP 143, SMTP 587).",
          "type": "string"
        }
      ]
    },
    "SettingKey": {
      "description": "A user setting that `set_setting` can change. All values are non-negative integers.",
      "oneOf": [
        {
          "const": "undo_send_ms",
          "description": "Undo-send window in milliseconds (0–60000).",
          "type": "string"
        },
        {
          "const": "poll_secs",
          "description": "INBOX poll interval in seconds (10–86400).",
          "type": "string"
        },
        {
          "const": "initial_window",
          "description": "Newest messages fetched on first sync of a mailbox (1–100000).",
          "type": "string"
        },
        {
          "const": "history_cap",
          "description": "Maximum undo history entries (1–10000).",
          "type": "string"
        },
        {
          "const": "theme",
          "description": "GUI theme mode: 0 = follow the system, 1 = light, 2 = dark; 3 and 4 still mean\nhigh-contrast dark and light (they set `theme_dark` or `theme_light`; see `set_theme`).",
          "type": "string"
        },
        {
          "const": "text_scale",
          "description": "GUI text and widget size in percent (50–300; Ctrl + plus/minus/0 change it too).",
          "type": "string"
        },
        {
          "const": "notifications",
          "description": "Desktop notifications while the GUI is in the background (new mail, failed sends,\napprovals): 0 = off, 1 = on.",
          "type": "string"
        },
        {
          "const": "list_density",
          "description": "Thread list rows: 0 = cozy (two lines), 1 = compact (one line), 2 = preview (three lines\nwith the snippet).",
          "type": "string"
        },
        {
          "const": "tui_colors",
          "description": "TUI colours: 0 = the terminal's own (bold, dim, reverse), 1 = the active theme's roles in\ntruecolor (`NO_COLOR` still turns them off).",
          "type": "string"
        },
        {
          "const": "background_sync",
          "description": "Android: mail checks while the app is not on screen: 0 = only while it is open,\n1 = periodic (every `background_interval_mins`), 2 = push (a permanent notification while\nthe IMAP IDLE watches run).",
          "type": "string"
        },
        {
          "const": "background_interval_mins",
          "description": "Android: minutes between periodic background checks (15–720).",
          "type": "string"
        }
      ]
    },
    "SettingsSection": {
      "description": "A section of the settings page.",
      "oneOf": [
        {
          "const": "appearance",
          "description": "Theme, density, text size.",
          "type": "string"
        },
        {
          "const": "keys",
          "description": "The key preset and the bindings.",
          "type": "string"
        },
        {
          "const": "general",
          "description": "Undo-send window, polling, notifications, history.",
          "type": "string"
        },
        {
          "const": "accounts",
          "description": "The accounts.",
          "type": "string"
        }
      ]
    },
    "ThemeMode": {
      "description": "The GUI's theme mode (`set_theme`).",
      "oneOf": [
        {
          "const": "system",
          "description": "Follow the desktop's light or dark preference.",
          "type": "string"
        },
        {
          "const": "light",
          "description": "Always light.",
          "type": "string"
        },
        {
          "const": "dark",
          "description": "Always dark.",
          "type": "string"
        }
      ]
    },
    "ThreadId": {
      "description": "A conversation that groups messages across mailboxes.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An action requested by the user or by an agent. Each variant is one tool in MCP, one\n`dail exec` command and one palette entry.\n\nJSON form: `{\"cmd\": \"<snake_case name>\", \"args\": {…}}`. Variants without arguments take\n`\"args\": {}` (or omit `args`, see [`Command::from_value`]).",
  "oneOf": [
    {
      "description": "Return the current user settings. Read-only.",
      "properties": {
        "args": {
          "type": "object"
        },
        "cmd": {
          "const": "get_settings",
          "type": "string"
        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Bind a command to keys in the GUI and the TUI, instead of its keys in the key preset.\nKeys are written like `e`, `Shift+U`, `Ctrl+Shift+Z`, `#` or a sequence like `g i`; keys\nbound here are taken away from other commands. Omit `keys` to go back to the preset's;\nan empty list unbinds the command. Undoable.",
      "properties": {
        "args": {
          "properties": {
            "command": {
              "description": "The command's name, e.g. `archive_threads`.",
              "type": "string"
            },
            "keys": {
              "description": "Its keys.",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        "cmd": {
          "const": "set_keybinding",
          "type": "string"
        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Choose the key bindings the GUI and the TUI start from: `gmail` (default) or `vim`.\nUndoable.",
      "properties": {
        "args": {
          "properties": {
            "preset": {
              "$ref": "#/$defs/KeyPreset",
              "description": "The preset."
            }
          },
          "required": [
            "preset"
          ],
          "type": "object"
        },
        "cmd": {
          "const": "set_key_preset",
          "type": "string"
        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Choose the GUI's look: the mode (`system` follows the desktop, `light`, `dark`) and the\ntheme for each mode, by name. Built-in themes: `dail-light`, `dail-dark`,\n`dail-light-hc`, `dail-dark-hc`. Give at least one field; a name is a slug (`a-z`, `0-9`,\n`-`, at most 64). An unknown name falls back to the mode's default theme in the GUI.\nOnly the look changes. Undoable.",
      "properties": {
        "args": {
          "properties": {
            "dark": {
              "description": "The theme of the dark mode, e.g. `dail-dark-hc`.",
              "type": [
                "string",
                "null"
              ]
            },
            "light": {
              "description": "The theme of the light mode, e.g. `dail-light-hc`.",
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ThemeMode"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mode."
            }
          },
          "type": "object"
        },
        "cmd": {
          "const": "set_theme",
          "type": "string"
        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Change one user setting. Undoable.",
      "properties": {
        "args": {
          "properties": {
            "key": {
              "$ref": "#/$defs/SettingKey",
              "description": "The setting to change."
            },
            "value": {
              "description": "The new value: a non-negative integer within the setting's allowed range."
            }
          },
          "required": [
            "key",
            "value"
          ],
          "type": "object"
        },
        "cmd": {
          "const": "set_setting",
          "type": "string"
        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Revert the most recent undoable command (from any front-end). Fails if there is nothing\nto undo.",
      "properties": {
        "args": {
          "type": "object"
        },
        "cmd": {
          "const": "undo",
          "type": "string"
        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Re-apply the most recently undone command. Fails if there is nothing to redo.",
      "properties": {
        "args": {
          "type": "object"
        },
        "cmd": {
          "const": "redo",
          "type": "string"
        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Open the command palette in the GUI.",
      "properties": {
        "args": {
          "type": "object"
        },
        "cmd": {
          "const": "open_palette",
          "type": "string"
        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Close the command palette in the GUI.",
      "properties": {
        "args": {
          "type": "object"
        },
        "cmd": {
          "const": "close_palette",
          "type": "string"
        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Add an IMAP/SMTP mail account. The password, if given, is stored in the OS keyring only;\nit never appears in state, config, receipts or logs. Run `test_account` afterwards to\ncheck the login. Undoable (undo removes the account and its keyring entry). Only the user\ncan add accounts (GUI or CLI); agents (MCP) get `origin_not_allowed`.",
      "properties": {
        "args": {
          "properties": {
            "display_name": {
              "description": "Name shown in the UI. Defaults to the email address.",
              "type": [
                "string",
                "null"
              ]
            },
            "email": {
              "description": "Email address; also the IMAP and SMTP login.",
              "type": "string"
            },
            "imap": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Endpoint"
                },
                {
                  "type": "null"
                }
              ],
              "description": "IMAP server. Overrides the preset; required for `custom`."
            },
            "password": {
              "description": "Password or App Password. Write-only: stored in the OS keyring and never echoed.",
              "type": [
                "string",
                "null"
              ],
              "writeOnly": true
            },
            "preset": {
              "$ref": "#/$defs/ProviderPreset",
              "description": "Provider preset. `gmail` needs an App Password (2-step verification on);\n`custom` needs `imap` and `smtp`."
            },
            "smtp": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Endpoint"
                },
                {
                  "type": "null"
                }
              ],
              "description": "SMTP submission server. Overrides the preset; required for `custom`."
            }
          },
          "required": [
            "preset",
            "email"
          ],
          "type": "object"
        },
        "cmd": {
          "const": "add_account",
          "type": "string"
        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Look up the IMAP and SMTP servers of an address's domain (ADR 0006): the provider's\nautoconfig file over HTTPS, else Mozilla's database of providers. Only the domain is sent.\nThe answer arrives in `status.discovery`; asking again for the same address then returns the\nservers found (`state: found`, `imap`, `smtp`, `source`). Nothing is configured by it.\nRead-only.",
      "properties": {
        "args": {
          "properties": {
            "email": {
              "description": "The address, e.g. `me@example.org`.",
              "type": "string"
            }
