        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Set how many of a mailbox's newest messages are kept in the local cache: older ones are\nfetched in the background, 200 at a time, until the window is full (progress in\n`list_mailboxes`). `0` keeps the whole mailbox; omitting `window` goes back to the\n`initial_window` setting. Messages cached already stay. Undoable.",
      "properties": {
        "args": {
          "properties": {
            "mailbox": {
