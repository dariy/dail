    },
    {
      "description": "Send a draft. It leaves after the undo-send window (`settings.undo_send_ms`, default 10 s):\nuntil then `cancel_send` or `undo` stops it, and the draft can't be edited. Needs at least\none recipient and every attachment checked. Agents (MCP) can't send without the user's\napproval.",
      "properties": {
        "args": {
          "properties": {
            "id": {
              "$ref": "#/$defs/DraftId",
              "description": "The draft to send."
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
