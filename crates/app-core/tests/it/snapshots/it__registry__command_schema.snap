    {
      "description": "Put back a discarded draft as it was; `undo` of `discard_draft` uses this. Its attachments\nare checked again. Fails if a draft with the same ID exists. Undoable (undo discards it\nagain). Only the user can run it directly (GUI or CLI); agents (MCP) get\n`origin_not_allowed` and use `undo` instead.",
      "properties": {
        "args": {
          "properties": {
            "draft": {
              "$ref": "#/$defs/Draft",
              "description": "The draft, as returned when it was discarded."
            }
          },
          "required": [
