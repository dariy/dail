        }
      },
      "required": [
        "cmd",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "Remove an attachment from a draft (the file itself is not touched). Undoable.",
      "properties": {
        "args": {
          "properties": {
            "draft": {
              "$ref": "#/$defs/DraftId",
              "description": "The draft."
            },
            "index": {
              "description": "Position in the draft's attachment list (0 = first).",
