    },
    {
      "description": "Attach a local file to a draft. Only the path is recorded: the file is checked in the\nbackground (it must exist; all attachments together may have at most 25 MiB; see the\nattachment's `state`) and read when the draft is saved or sent. Undoable.",
      "properties": {
        "args": {
          "properties": {
            "draft": {
              "$ref": "#/$defs/DraftId",
              "description": "The draft."
            },
            "index": {
              "description": "Position in the attachment list (0 = first). Omit to append.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "path": {
              "description": "Absolute path of the file.",
              "type": "string"
            }
          },
          "required": [
            "draft",
            "path"
          ],
          "type": "object"
        },
        "cmd": {
          "const": "attach_file",
