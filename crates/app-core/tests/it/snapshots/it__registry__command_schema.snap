    },
    {
      "description": "Change an account's display name or servers. Give at least one field. Changing a server\nresets the account's status to `unverified`. Undoable. Only the user can change accounts\n(GUI or CLI); agents (MCP) get `origin_not_allowed`.",
      "properties": {
        "args": {
          "properties": {
