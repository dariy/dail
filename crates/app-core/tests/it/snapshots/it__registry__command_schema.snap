    },
    {
      "description": "Stop a scheduled send before it leaves; the draft becomes editable again. Undoable\n(undo schedules the send again).",
      "properties": {
        "args": {
          "properties": {
            "id": {
              "$ref": "#/$defs/DraftId",
              "description": "The draft whose send to stop."
            }
          },
          "required": [
