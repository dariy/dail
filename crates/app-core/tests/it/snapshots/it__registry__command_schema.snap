    {
      "description": "Collapse folders in the sidebar's folder tree, so that the folders below them are\nhidden; a collapsed account hides all its folders. Idempotent, unlike a toggle: repeating\nit changes nothing. Saved across restarts.",
      "properties": {
        "args": {
          "properties": {
            "keys": {
