# dail configuration, written by dail. Passwords are stored in the OS keyring, never in this file.

[settings]
undo_send_ms = 10000
poll_secs = 300
initial_window = 500
history_cap = 200
theme = 0
theme_light = "dail-light"
theme_dark = "dail-dark"
list_density = 0
tui_colors = 0
text_scale = 100
notifications = 1
background_sync = 1
background_interval_mins = 30
mark_read_after_ms = 2000
stale_secs = 60
full_sync_secs = 900
after_triage = 0
images_from = ["news@example.org"]
key_preset = "vim"

[settings.keys]
archive_threads = ["y"]

[settings.updates]
checks = "unset"
interval_hours = 24

[[account]]
id = "00000000-0000-0000-0000-000000000001"
display_name = "Account 1"
email = "a@example.org"
preset = "custom"

[account.imap]
host = "mail.example.org"
port = 143
security = "starttls"

[account.smtp]
host = "mail.example.org"
port = 465
security = "tls"

[account.secret]
service = "dail"
user = "account/00000000-0000-0000-0000-000000000001"

[[account.identity]]
email = "sales@example.org"
name = "Sales"
signature = """
Sales team
Example"""

[[account]]
id = "00000000-0000-0000-0000-000000000002"
display_name = "Account 2"
email = "b@example.org"
preset = "custom"

[account.imap]
host = "mail.example.org"
port = 143
security = "starttls"

[account.smtp]
host = "mail.example.org"
port = 465
security = "tls"

[account.secret]
service = "dail"
user = "account/00000000-0000-0000-0000-000000000002"
