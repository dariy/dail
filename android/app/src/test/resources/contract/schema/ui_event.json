{
  "$defs": {
    "DraftId": {
      "description": "A local draft.",
      "format": "uuid",
      "type": "string"
    },
    "Field": {
      "description": "A text field of the composer.",
      "oneOf": [
        {
          "const": "to",
          "description": "`To` recipients.",
          "type": "string"
        },
        {
          "const": "cc",
          "description": "`Cc` recipients.",
          "type": "string"
        },
        {
          "const": "bcc",
          "description": "`Bcc` recipients.",
          "type": "string"
        },
        {
          "const": "subject",
          "description": "The subject.",
          "type": "string"
        },
        {
          "const": "body",
          "description": "The body.",
          "type": "string"
        },
        {
          "const": "query",
          "description": "The palette's input.",
          "type": "string"
        },
        {
          "const": "email",
          "description": "Account setup: the email address.",
          "type": "string"
        },
        {
          "const": "name",
          "description": "Account setup: the display name.",
          "type": "string"
        },
        {
          "const": "imap",
          "description": "Account setup: the IMAP server (`host:port`).",
          "type": "string"
        },
        {
          "const": "smtp",
          "description": "Account setup: the SMTP server (`host:port`).",
          "type": "string"
        },
        {
          "const": "password",
          "description": "Account setup: the password. It never comes back in a frame: the presenter moves it\ninto a `Secret` for the keyring.",
          "type": "string"
        }
      ]
    },
    "NoteAct": {
      "description": "What a tap or a button of a notification does.",
      "oneOf": [
        {
          "description": "Archive these threads.",
          "properties": {
            "act": {
              "const": "archive",
              "type": "string"
            },
            "threads": {
              "description": "The threads.",
              "items": {
                "$ref": "#/$defs/ThreadId"
              },
              "type": "array"
            }
          },
          "required": [
            "act",
            "threads"
          ],
          "type": "object"
        },
        {
          "description": "Mark these threads read.",
          "properties": {
            "act": {
              "const": "mark_read",
              "type": "string"
            },
            "threads": {
              "description": "The threads.",
              "items": {
                "$ref": "#/$defs/ThreadId"
              },
              "type": "array"
            }
          },
          "required": [
            "act",
            "threads"
          ],
          "type": "object"
        },
        {
          "description": "Open this thread in the reader.",
          "properties": {
            "act": {
              "const": "open_thread",
              "type": "string"
            },
            "thread": {
              "$ref": "#/$defs/ThreadId",
              "description": "The thread."
            }
          },
          "required": [
            "act",
            "thread"
          ],
          "type": "object"
        },
        {
          "description": "Open this draft in the composer.",
          "properties": {
            "act": {
              "const": "open_draft",
              "type": "string"
            },
            "draft": {
              "$ref": "#/$defs/DraftId",
              "description": "The draft."
            }
          },
          "required": [
            "act",
            "draft"
          ],
          "type": "object"
        },
        {
          "description": "Stop push: `background_sync` back to 1 (periodic checks).",
          "properties": {
            "act": {
              "const": "stop_push",
              "type": "string"
            }
          },
          "required": [
            "act"
          ],
          "type": "object"
        },
        {
          "description": "Open the system's battery-optimization settings (a host action; no command).",
          "properties": {
            "act": {
              "const": "battery_settings",
              "type": "string"
            }
          },
          "required": [
            "act"
          ],
          "type": "object"
        }
      ]
    },
    "ThreadId": {
      "description": "A conversation that groups messages across mailboxes.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One event from the host, in the order the user caused it. Kotlin never builds a command: it\nreturns the action IDs of the frame it shows.",
  "oneOf": [
    {
      "description": "The window and the system settings, at start and whenever they change.",
      "properties": {
        "args": {
          "properties": {
            "dark": {
              "default": false,
              "description": "The system's dark mode.",
              "type": "boolean"
            },
            "font_scale": {
              "default": 1.0,
              "description": "The system's font scale (1.0 = default).",
              "format": "float",
              "type": "number"
            },
            "height_dp": {
              "description": "Window height in dp.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "keyboard": {
              "default": false,
              "description": "A hardware keyboard is attached.",
              "type": "boolean"
            },
            "locale": {
              "default": null,
              "description": "The system's language tag (`en-US`; `en-XA` is the pseudo-locale).",
              "type": [
                "string",
                "null"
              ]
            },
            "width_dp": {
              "description": "Window width in dp.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "width_dp",
            "height_dp"
          ],
          "type": "object"
        },
        "event": {
          "const": "configure",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "The app came on screen (`true`) or left it.",
      "properties": {
        "args": {
          "properties": {
            "visible": {
              "description": "Whether an activity is visible.",
              "type": "boolean"
            }
          },
          "required": [
            "visible"
          ],
          "type": "object"
        },
        "event": {
          "const": "visible",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "A tap on something carrying an action ID.",
      "properties": {
        "args": {
          "properties": {
            "action": {
              "description": "The action.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        "event": {
          "const": "tap",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "A long press on something carrying a long-press action ID.",
      "properties": {
        "args": {
          "properties": {
            "action": {
              "description": "The action.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        "event": {
          "const": "long_press",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "A row swiped past its threshold (the row's `swipe_start` or `swipe_end` action).",
      "properties": {
        "args": {
          "properties": {
            "action": {
              "description": "The action.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        "event": {
          "const": "swipe",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "The thread list scrolled: rows `first..first + count` are visible.",
      "properties": {
        "args": {
          "properties": {
            "count": {
              "description": "How many rows are visible.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "first": {
              "description": "The first visible row.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "first",
            "count"
          ],
          "type": "object"
        },
        "event": {
          "const": "scrolled",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "System Back (only sent while the frame's `back` is true).",
      "properties": {
        "event": {
          "const": "back",
          "type": "string"
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    {
      "description": "Pull to refresh.",
      "properties": {
        "event": {
          "const": "refresh",
          "type": "string"
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    {
      "description": "A network came back while the app is visible: syncs, as a pull would (nothing while the\napp is off screen or has no account).",
      "properties": {
        "event": {
          "const": "online",
          "type": "string"
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    {
      "description": "A tap on a notification: what its `open` said, passed back verbatim (opens the thread\nor the draft, if it still exists).",
      "properties": {
        "args": {
          "properties": {
            "act": {
              "$ref": "#/$defs/NoteAct",
              "description": "The notification's `open`."
            }
          },
          "required": [
            "act"
          ],
          "type": "object"
        },
        "event": {
          "const": "notification",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "A text field changed (the whole text, as the IME left it).",
      "properties": {
        "args": {
          "properties": {
            "field": {
              "$ref": "#/$defs/Field",
              "description": "The field."
            },
            "text": {
              "description": "Its text.",
              "type": "string"
            }
          },
          "required": [
            "field",
            "text"
          ],
          "type": "object"
        },
        "event": {
          "const": "text",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "The focus left a text field.",
      "properties": {
        "args": {
          "properties": {
            "field": {
              "$ref": "#/$defs/Field",
              "description": "The field."
            }
          },
          "required": [
            "field"
          ],
          "type": "object"
        },
        "event": {
          "const": "blur",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "A key chord from a hardware keyboard, in the keymap's notation (`Ctrl+Z`, `j`, `#`).",
      "properties": {
        "args": {
          "properties": {
            "chord": {
              "description": "The chord.",
              "type": "string"
            }
          },
          "required": [
            "chord"
          ],
          "type": "object"
        },
        "event": {
          "const": "key",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "A key pressed on a hardware keyboard that no text field took, as Android reports it; the\npresenter maps it onto the keymap (`app_mobile::keys`).",
      "properties": {
        "args": {
          "properties": {
            "alt": {
              "default": false,
              "description": "Alt is held.",
              "type": "boolean"
            },
            "code": {
              "description": "`KeyEvent.getKeyCode()`.",
              "format": "int32",
              "type": "integer"
            },
            "ctrl": {
              "default": false,
              "description": "Ctrl is held.",
              "type": "boolean"
            },
            "meta": {
              "default": false,
              "description": "Meta (Search, Windows) is held.",
              "type": "boolean"
            },
            "shift": {
              "default": false,
              "description": "Shift is held.",
              "type": "boolean"
            },
            "unicode": {
              "default": 0,
              "description": "The character as typed with Shift only (`getUnicodeChar` without Ctrl, Alt and Meta);\n0 for none.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        "event": {
          "const": "key_down",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    },
    {
      "description": "The clock moved on (sent every second while the frame's `wants_tick` is true).",
      "properties": {
        "event": {
          "const": "tick",
          "type": "string"
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    {
      "description": "Another app opened a `mailto:` link or shared text or files with dail: a new draft from\nthe current account opens in the composer. It is never sent. Only `content://` files of\nother apps are attached (copied first); `file://` URIs and dail's own are refused.",
      "properties": {
        "args": {
          "properties": {
            "files": {
              "description": "The shared files' URIs (`EXTRA_STREAM`).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "mailto": {
              "description": "The `mailto:` URI, if it was one.",
              "type": [
                "string",
                "null"
              ]
            },
            "subject": {
              "description": "The subject (`EXTRA_SUBJECT`).",
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "description": "The text (`EXTRA_TEXT`).",
              "type": [
                "string",
                "null"
              ]
            },
            "to": {
              "description": "Addresses (`EXTRA_EMAIL`).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "event": {
          "const": "share",
          "type": "string"
        }
      },
      "required": [
        "event",
        "args"
      ],
      "type": "object"
    }
  ],
  "title": "UiEvent"
}
