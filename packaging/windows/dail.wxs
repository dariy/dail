<?xml version="1.0" encoding="utf-8"?>
<!-- The MSI of dail (Wave 7 R1), built with WiX v5 by scripts/release-windows.ps1:
     `wix build -arch x64 -d Version=<x.y.z> -d Exe=<path to dail.exe> -d Icon=<path to dail.ico> -o dail.msi packaging/windows/dail.wxs`.
     A per-machine install into Program Files\dail with a Start menu shortcut, and that folder appended to the
     system PATH (DSK-3), so `dail mcp`, `dail exec` and `dail tui` are found in a new terminal and by an agent's MCP
     configuration; uninstalling removes the entry. The UpgradeCode never changes, so a
     newer MSI replaces an older one (MajorUpgrade); a downgrade is refused. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="dail" Manufacturer="dail developers" Version="$(Version)"
           UpgradeCode="6f1c2a7e-3d8b-4e59-9a41-0d2b7c5e8f13" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of dail is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- Add/Remove Programs shows the dail icon (dail.ico, from `cargo xtask icons`); the shortcut takes dail.exe's own. -->
    <Icon Id="dail.ico" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="dail.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="dail" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main">
      <Component Directory="INSTALLFOLDER">
        <File Id="DailExe" Source="$(Exe)" KeyPath="yes">
          <Shortcut Name="dail" Directory="ProgramMenuFolder" Arguments="gui" WorkingDirectory="INSTALLFOLDER" />
        </File>
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes"
                     Permanent="no" />
      </Component>
    </Feature>
  </Package>
</Wix>
